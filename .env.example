# Gemini API
GEMINI_API_KEY=

# Database (Railway Postgres or local)
DATABASE_URL=postgresql://user:password@localhost:5432/signal_forge

# Email Configuration
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
ALERT_EMAIL=alerts@example.com

# Breakout Agent Config - Option 1: Load from file (recommended for large lists)
# ASSETS_FILE_PATH=./scripts/scanner-lists/nyse-all-tradingview-import.txt
# ASSETS_MODE=tier
# ASSETS_TIER=1
# ASSETS_TIER_SIZE=50

# Breakout Agent Config - Option 2: Comma-separated list (for small lists)
SCAN_ASSETS=AAPL,MSFT,NVDA
DATA_SOURCE=ibkr
CRON_SCHEDULE=0 * * * *

# IB Client Portal Gateway
IBKR_BASE_URL=https://localhost:5000

# Trading agent (apps/trading-agent) — executes emailed graded breakouts as
# Alpaca orders. Off by default. docs/autotrading.md has the full runbook.
TRADING_ENABLED=false
TRADING_MODE=paper                 # paper | live
# TRADING_LIVE_CONFIRM=I_UNDERSTAND  # required (in addition to TRADING_MODE=live) before any real order
ALPACA_API_KEY=
ALPACA_API_SECRET=
# Operating point (docs/exit-rules-study.md sizing grid). One lever:
#   invested      10 slots, 1% risk, trail 20% on every grade  (~9%/yr, 38% max DD)
#   conservative   5 slots, 1% risk, trail 20% on every grade  (~7%/yr, 31% max DD, ~1/3 cash)
TRADE_PROFILE=invested
# Any explicit knob below overrides the profile:
# TRADE_RISK_PCT=1                 # % of equity lost if the stop fills
# TRADE_MAX_POSITION_PCT=20        # % of equity per position
# TRADE_MAX_OPEN_POSITIONS=10
# TRADE_MAX_DAILY_LOSS_PCT=3       # halt new entries after this intraday drawdown
# TRADE_MAX_SIGNAL_AGE_HOURS=24    # ignore alerts older than this
# TRADE_MAX_PCT_ABOVE_PIVOT=5      # skip entries extended past the base pivot
# Sell rules (docs/exit-rules-study.md): 7% stop always; then
# Selection and market switch (docs/exit-rules-study.md: strongest-first slot
# filling took the simulated book from 9% to 14%/yr; the 200MA switch halved the drawdown):
# TRADE_RS_MIN=0                   # skip candidates with rsRating below this (0 = rank only, no floor)
# TRADE_REGIME_MA=200              # SPY close vs this SMA gates entries; 0 disables
# TRADE_REGIME_EXIT=true           # also flatten every position while SPY is below it
# TRADE_REGIME_SYMBOL=SPY
# TRADE_MA_EXIT=50                 # sell next open after a close below this SMA; 0 disables
# TRADE_TRAIL_PCT=20               # trail the stop 20% under the peak high instead of the MA rule; 0 disables
# TRADE_TRAIL_GRADES=S,A+,A        # which grades the trail manages; the rest use the MA exit
# TRADE_HOLD_DAYS=365              # backstop time exit (calendar days); 0 disables. A 90-day cap cuts the trail rule from 14% to 11.6%/yr
# TRADE_ALLOWED_GRADES=S,A+,A
# TRADE_ALLOW_ETFS=true
# TRADE_CRON_SCHEDULE=*/5 * * * 1-5  (New York time)

# X (Twitter) auto-posting — off unless X_POST_ENABLED=true and all four
# OAuth 1.0a user tokens are set (create them in the X developer portal for the
# account you post from). Posts mirror the email alert, gated by the same dedup.
X_POST_ENABLED=false
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
# All X posting runs from the shard-0 tier only. Three jobs, all optional to tune:
# 1) Signal teasers — top breakouts, twice a day:
#    X_TEASER_CRON=0 12,16 * * 1-5   (default)   X_TEASER_MAX=2
# 2) Performance audit — monthly recap from the backtest engine:
#    X_AUDIT_CRON=0 13 1 * *         (default)
# 3) Earnings breakdowns are posted MANUALLY from the dashboard: open a symbol's
#    drawer and click "🐦 Tweet" (admin only — gated by Clerk private metadata
#    admin:"true"). No schedule. The dashboard container needs the X_* tokens too.
# DASHBOARD_URL=http://dashboard:3000  (audit fetches /api/backtest from here)
