# Gemini API
GEMINI_API_KEY=

# Database (Railway Postgres or local)
DATABASE_URL=postgresql://user:password@localhost:5432/signal_forge

# Email Configuration
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
ALERT_EMAIL=alerts@example.com

# Breakout Agent Config - Option 1: Load from file (recommended for large lists)
# ASSETS_FILE_PATH=./scripts/scanner-lists/nyse-all-tradingview-import.txt
# ASSETS_MODE=tier
# ASSETS_TIER=1
# ASSETS_TIER_SIZE=50

# Breakout Agent Config - Option 2: Comma-separated list (for small lists)
SCAN_ASSETS=AAPL,MSFT,NVDA
DATA_SOURCE=ibkr
CRON_SCHEDULE=0 * * * *

# IB Client Portal Gateway
IBKR_BASE_URL=https://localhost:5000

# Trading Agent Config
MAX_POSITION_SIZE=95
STOP_LOSS_PERCENT=0.02
TRADE_CRON_SCHEDULE=*/5 * * * *
