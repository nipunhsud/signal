// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model BreakoutSignal {
  id String @id @default(cuid())

  // Asset being traded
  asset String
  assetType String @default("stock") // "stock" or "etf"

  // Agent analysis
  confidence Float @default(0)
  agentDecision String?
  shouldAlert Boolean @default(false)

  // Price levels
  resistance Float
  support Float
  currentPrice Float

  // Frozen trade setup — snapshotted at the moment breakoutType flips from
  // "unknown" → Type1/Type3, and never recomputed while the signal stays active.
  // Prevents the rolling 20-bar Donchian resistance from silently changing the
  // reported entry level after the breakout candle enters the window.
  entryPrice Float?
  stopLoss Float?

  // Pine Script breakout scanner
  pineScriptGreen Boolean @default(false) // Full green cone: all conditions met
  barsInRange Int @default(0) // Consolidation bars
  bullishCandle Boolean @default(false) // Close > Open

  // Fundamentals
  epsGrowthPct Float?
  revenueGrowthPct Float?
  epsBeat Boolean?
  epsSurprisePct Float?
  sector String?
  industry String?
  fedFundsRate Float?
  volumeRatio Float?

  // ETF-specific
  expenseRatio Float?
  assetUnderManagement Float?
  etfCategory String?

  // Earnings call snapshot (Type 1/3 stocks only) — cached from TranscriptAnalysis
  earningsTone      String? // "bullish" | "neutral" | "bearish"
  earningsToneScore Float?  // -1.0 to +1.0
  earningsGuidance  String? // "raised" | "maintained" | "lowered" | "none"
  earningsQuarter   Int?
  earningsYear      Int?

  // Type 1 vs Type 3 classification
  breakoutType String @default("unknown") // "Type1" (fresh), "Type3" (continuation), "unknown"
  isVcp Boolean @default(false) // Type1 VCP: tight base (ATR%<2.5), contracting (ATR5/ATR20<0.75), upside expansion (TR≥1.5x ATR)

  // Base-quality metrics (computed over the ~20-bar base, today's bar excluded)
  rsRating Int? // 1-99 relative-strength percentile vs the scanned universe (AssetReturn table)
  upDownVolumeRatio Float? // up-day volume / down-day volume — >1.5 = accumulation
  failedPokes Int @default(0) // bars that wicked to within 0.5% of the pivot but closed >1% below it
  isBlueSky Boolean @default(false) // pivot within 2% of the 52-week high — no trapped sellers overhead
  coilRatio Float? // base 2nd-half range / 1st-half range — <1 = tightening into the pivot
  priorBaseDays Int @default(0) // # of days in prior consolidation
  priorBaseRangePercent Float @default(0) // % range of that base
  priorBreakoutBarsAgo Int @default(0) // bars ago since prior high-volume breakout
  extensionPriorBreakoutBarsAgo Int @default(0) // 1-5: bars ago a recent (last 5 bars) breakout fired — used by Type 3 extensions
  liquidityOk Boolean @default(false) // >= 100k avg volume

  // Email alert tracking (deduplication)
  alertSentAt DateTime?       // When first alert was sent
  lastAlertPrice Float?       // Price when last alert was sent
  lastAlertAt DateTime?       // Timestamp of last alert (for re-alerts)

  // X (Twitter) digest tracking — set when the asset is included in a posted
  // digest thread, so the second daily digest doesn't repeat the same ticker.
  xPostedAt DateTime?
  // Set when an earnings-calendar-timed card for this asset was posted (separate
  // from xPostedAt so teasers and earnings-intercepts dedup independently).
  earningsPostedAt DateTime?

  // Timing
  signalDate DateTime?        // When the signal actually occurred (market candle date), not when logged
  createdAt DateTime @default(now())
  executedAt DateTime?

  // For aggregation
  @@index([asset, createdAt])
  @@index([shouldAlert, createdAt])
  @@index([pineScriptGreen, createdAt])
  @@index([asset, alertSentAt])
  @@index([xPostedAt])
  @@index([earningsPostedAt])
}

// Trailing returns per scanned asset, upserted by every tier/shard on each scan.
// Exists so relative strength can be ranked cross-sectionally: the universe is
// split across tier containers, so no single process sees all returns in memory.
model AssetReturn {
  asset       String @id
  assetType   String @default("stock") // rank stocks against stocks, etfs against etfs
  region      String @default("US") // "US" | "IN" — RS percentiles are per-market
  sector      String? // FMP sector — powers the sector-strength rollup
  rsScore     Float // weighted trailing return: 0.5*3m + 0.3*1m + 0.2*1w
  return1wPct Float?
  return1mPct Float?
  return3mPct Float?
  updatedAt   DateTime @updatedAt

  @@index([region, assetType, updatedAt])
}

// Runtime feature flags togglable from the admin UI without a redeploy —
// e.g. fmp_disabled: scanners switch to Yahoo-only data on the next cycle.
model RuntimeFlag {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// Winner-model screen (MissionWinners-style): stocks with strong prior-quarter
// EPS/revenue growth setting up technically (near 52w high, above stacked MAs).
// Populated by the same market-data fetch as BreakoutSignal, no extra API calls.
model WinnerSignal {
  id String @id @default(cuid())

  asset       String
  screenType  String  // "setup" (fundamentals + technical setup) | "moving-1w" | "moving-1m" | "moving-3m"
  tier        String  // "A" (both ≥50%), "B" (one ≥50%), "C" (both ≥30%)
  confidence  Float   @default(0)

  currentPrice Float
  high52w      Float?
  distFrom52wHighPct Float?
  ma50         Float?
  ma200        Float?
  maStacked    Boolean @default(false)  // close > MA50 > MA200
  returnPct    Float?  // trailing return for moving-* screens; null for setup

  // Fundamentals snapshot
  epsGrowthPct     Float?
  revenueGrowthPct Float?
  earningsQuarter  Int?
  earningsYear     Int?

  sector   String?
  industry String?

  signalDate DateTime?
  createdAt  DateTime @default(now())

  @@unique([asset, screenType])
  @@index([asset, createdAt])
  @@index([screenType, createdAt])
  @@index([tier, createdAt])
}

// Subscriber record — one row per Clerk user who has (or had) a billing
// relationship with us. Keyed by Clerk userId (the source of identity), joined
// to Stripe via customerId. Subscription status drives the paywall check on
// /dashboard.
model User {
  id                    String    @id @default(cuid())
  clerkUserId           String    @unique   // Clerk's user_xxx identifier
  email                 String?
  stripeCustomerId      String?   @unique
  stripeSubscriptionId  String?   @unique

  // Stripe subscription status: "trialing" | "active" | "past_due" | "canceled" | "unpaid" | "incomplete"
  // See https://stripe.com/docs/api/subscriptions/object#subscription_object-status
  subscriptionStatus    String?
  trialEndsAt           DateTime?
  currentPeriodEndsAt   DateTime?
  cancelAtPeriodEnd     Boolean   @default(false)

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  shortlistLists        ShortlistList[]

  @@index([subscriptionStatus])
}

// Extensible for future agents
model Signal {
  id String @id @default(cuid())

  agentName String // "BreakoutAgent", "SentimentAgent", etc.
  asset String
  signalType String // "breakout", "reversal", "divergence", etc.

  confidence Float
  metadata Json // Flexible storage for agent-specific data

  shouldAlert Boolean @default(false)
  createdAt DateTime @default(now())
  executedAt DateTime?

  @@index([agentName, asset])
  @@index([shouldAlert, createdAt])
}

model AgentRun {
  id String @id @default(cuid())

  agentName String
  status String // "success", "error", "partial"
  signalsFound Int @default(0)
  alertsSent Int @default(0)

  errorMessage String?
  duration Int // ms

  startedAt DateTime @default(now())
  completedAt DateTime?

  @@index([agentName, completedAt])
}

model Trade {
  id               String    @id @default(cuid())
  breakoutSignalId String
  asset            String
  conid            String
  orderId          String?
  side             String    // "BUY"
  quantity         Int
  entryPrice       Float
  stopLossPrice    Float
  positionValue    Float
  maxPositionSize  Float
  status           String    // "submitted" | "error"
  errorMessage     String?
  accountId        String
  cashBefore       Float
  createdAt        DateTime  @default(now())
  filledAt         DateTime?

  @@index([asset, createdAt])
  @@index([status, createdAt])
  @@index([breakoutSignalId])
}

// A named, per-user collection (e.g. "US", "India"). Tickers hang off it via
// Shortlist. Deleting a list cascades its items.
model ShortlistList {
  id        String      @id @default(cuid())
  userId    String
  name      String
  order     Int         @default(0)
  createdAt DateTime    @default(now())
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     Shortlist[]

  @@unique([userId, name])
  @@index([userId])
}

model Shortlist {
  id        String        @id @default(cuid())
  listId    String
  asset     String
  notes     String?
  addedAt   DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  list      ShortlistList @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@unique([listId, asset])
  @@index([listId])
}

model RemovedAsset {
  id        String   @id @default(cuid())
  asset     String   @unique
  removedAt DateTime @default(now())

  @@index([asset])
}

// Per-scan aggregate of stocks in a valid setup-base state (loose 3-9 bar
// consolidation with bullish MAs, low volume). Individual base rows aren't
// tradable signals because the 10-bar setup detector can't identify real
// O'Neil bases (25-35 bars) — but the count is a market-breadth signal:
// rising = accumulation across many names, falling = distribution.
model MarketBreadth {
  id           String   @id @default(cuid())
  mode         String   // "stocks" | "etfs"
  baseCount    Int      // stocks in setup-base state (breadth signal)
  handleCount  Int      // stocks in tradable setup-handle state (in Signal table)
  totalScanned Int
  createdAt    DateTime @default(now())

  @@index([mode, createdAt])
}

model TranscriptAnalysis {
  id      String @id @default(cuid())
  asset   String
  quarter Int
  year    Int

  tone              String  // "bullish" | "neutral" | "bearish"
  toneScore         Float   // -1.0 to +1.0
  guidanceDirection String  // "raised" | "maintained" | "lowered" | "none"
  riskFlags         Json    // string[]
  highlights        Json    // string[]
  summary           String

  modelUsed    String
  inputTokens  Int
  outputTokens Int

  xPostedAt DateTime? // set once this earnings breakdown has been posted to X

  createdAt DateTime @default(now())

  @@unique([asset, quarter, year])
  @@index([asset, createdAt])
  @@index([xPostedAt])
}
