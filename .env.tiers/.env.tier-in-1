# India (NSE) scanner — shard 1 of 2. Mirrors the US tiers but REGION=IN drives
# the NSE universe + IST market hours. ~1190 NSE names / 2 shards ≈ 595 each.
REGION=IN

# Asset Loading: Dynamic (FMP) — REGION=IN makes fetchAssetsFromFMP query exchange=NSE
DYNAMIC_ASSETS=true
ASSETS_FILE_PATH=../../scripts/scanner-lists/nse-500-tradingview-import.txt
ASSETS_MODE=all

# Data Source
DATA_SOURCE=fmp
FMP_API_KEY=e5ccbcc74abe54698f96836dd4c51d48

# Universe Filtering — small floor keeps the full actively-traded NSE list (~1190)
MIN_MARKET_CAP=100000000
MIN_VOLUME=100000

# Sharding: India shard 1 of 2
SHARD_INDEX=0
SHARD_TOTAL=2
RATE_LIMIT_PER_MIN=300

# Gemini AI
GEMINI_API_KEY=AIzaSyB0uXIra4ZlhPlz-W39HVEiQ2Cii-jCNiA

# Database
DATABASE_URL=postgresql://nipunsud@localhost:5432/signal_forge

# Email
EMAIL_SERVICE=gmail
EMAIL_USER=nipunhsud@gmail.com
EMAIL_PASS=raneqactzyexzkxq
ALERT_EMAIL=nipunhsud@gmail.com

# Schedule: exactly two scans per weekday — 9:30 (post-open) and 15:00 (pre-close)
# IST. Two ';'-separated crons (index.ts splits them). Minimal FMP bandwidth.
TZ=Asia/Kolkata
CRON_SCHEDULE=30 9 * * 1-5;0 15 * * 1-5
